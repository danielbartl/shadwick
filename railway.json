{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      ".dockerignore",
      "railway.json",
      "pom.xml",
      "mvnw",
      ".mvn/**",
      "shadwick-core/**",
      "shadwick-examples/**",
      "LICENSE",
      "NOTICE"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "sleepApplication": false,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
